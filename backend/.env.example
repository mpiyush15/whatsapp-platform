# ─── Platform WhatsApp (Replysys WABA) ───
PLATFORM_AUTH_ACCOUNT_ID=your-account-id-here
PLATFORM_OTP_PHONE_NUMBER_ID=your-phone-number-id
PLATFORM_OTP_TEMPLATE_LOGIN=your-template-name
PLATFORM_OTP_TEMPLATE_SIGNUP=your-template-name

# Billing / system templates
BILLING_ONBOARDING_PHONE_NUMBER_ID=your-phone-number-id
BILLING_ONBOARDING_TEMPLATE_NAME=your-template-name
PLATFORM_PAYMENT_REMINDER_TEMPLATE=your-template-name
PLATFORM_LOW_CREDIT_TEMPLATE=your-template-name
PLATFORM_RENEWAL_REMINDER_TEMPLATE=your-template-name

# Account setup script defaults
PLATFORM_SUPERADMIN_EMAIL=your-email@example.com
PLATFORM_WABA_ACCOUNT_EMAIL=your-email@example.com
PLATFORM_WABA_ACCOUNT_ID=your-account-id

# OTP tuning
PLATFORM_OTP_TTL_MS=600000
PLATFORM_OTP_RESEND_COOLDOWN_MS=60000
PLATFORM_OTP_MAX_SENDS_PER_HOUR=5
PLATFORM_OTP_MAX_VERIFY_ATTEMPTS=5
PLATFORM_PHONE_VERIFY_JWT_EXPIRES=20m

# Daily low-credit + renewal WhatsApp sweep
PLATFORM_BILLING_REMINDER_ENABLED=true
PLATFORM_BILLING_REMINDER_INTERVAL_MS=86400000
