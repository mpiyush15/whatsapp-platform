# Frontend Environment Configuration - Example

# API Configuration
# Local development: Backend running on localhost:5050
# Production: Use your backend API domain
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Socket.io Configuration
# For realtime updates (messages, notifications, etc)
# Local: localhost:5050
# Production: Your backend domain (same as API_URL base)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5050

# Google OAuth Configuration
# Get from Google Cloud Console
# https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
